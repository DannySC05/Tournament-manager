# Desarrollo y migraciones: usa la conexion directa de Supabase (URI).
# Vercel: usa el Shared Pooler de transacciones, puerto 6543.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-[REGION].pooler.supabase.com:6543/postgres
PG_POOL_MAX=1

# Genera un valor largo y aleatorio; nunca lo subas al repositorio.
JWT_SECRET=reemplaza-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_SECONDS=28800
