        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const data = pm.response.json();",
              "pm.collectionVariables.set('token_consulta', data.token);",
              "pm.test('rol CONSULTA', () => pm.expect(data.user.rol).to.eql('CONSULTA'));"
            ],
            "type": "text/javascript"
