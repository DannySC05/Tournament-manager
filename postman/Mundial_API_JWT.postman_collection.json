{
  "info": {
    "name": "Mundial API REST con JWT",
    "description": "Pruebas de autenticacion, autorizacion, reglas de negocio, validaciones minimas y tabla de posiciones.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000" },
    { "key": "token_admin", "value": "" },
    { "key": "token_consulta", "value": "" },
    { "key": "seleccion_local_id", "value": "" },
    { "key": "seleccion_visitante_id", "value": "" },
    { "key": "partido_id", "value": "" },
    { "key": "argentina_id", "value": "" },
    { "key": "francia_id", "value": "" },
    { "key": "marruecos_id", "value": "" },
    { "key": "pendiente_id", "value": "" },
    { "key": "semifinal_reservada_id", "value": "" },
    { "key": "final_reservada_id", "value": "" }
  ],
  "item": [
    {
      "name": "Auth - registrar primer ADMIN",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const data = pm.response.json();",
              "pm.collectionVariables.set('token_admin', data.token);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Administrador\",\n  \"email\": \"admin@mundial.test\",\n  \"password\": \"Admin1234\",\n  \"rol\": \"ADMIN\"\n}"
        }
      }
    },
    {
      "name": "Auth - login ADMIN",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('token_admin', pm.response.json().token);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@mundial.test\",\n  \"password\": \"Admin1234\"\n}"
        }
      }
    },
    {
      "name": "Auth - me",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": "{{base_url}}/api/auth/me"
      }
    },
    {
      "name": "Selecciones - crear local",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('seleccion_local_id', pm.response.json().data.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_admin}}" }
        ],
        "url": "{{base_url}}/api/selecciones",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Ecuador\",\n  \"continente\": \"CONMEBOL\",\n  \"grupo\": \"A\",\n  \"ranking_fifa\": 31,\n  \"entrenador\": \"Felix Sanchez\"\n}"
        }
      }
    },
    {
      "name": "Selecciones - crear visitante",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('seleccion_visitante_id', pm.response.json().data.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_admin}}" }
        ],
        "url": "{{base_url}}/api/selecciones",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Brasil\",\n  \"continente\": \"CONMEBOL\",\n  \"grupo\": \"A\",\n  \"ranking_fifa\": 5,\n  \"entrenador\": \"Dorival Junior\"\n}"
        }
      }
    },
    {
      "name": "Selecciones - listar",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": "{{base_url}}/api/selecciones"
      }
    },
    {
      "name": "Selecciones - detalle",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": "{{base_url}}/api/selecciones/{{seleccion_local_id}}"
      }
    },
    {
      "name": "Partidos - rechaza seleccion contra si misma",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.test('400 Bad Request', () => pm.response.to.have.status(400));"],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_admin}}" }
        ],
        "url": "{{base_url}}/api/partidos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"seleccion_local_id\": {{seleccion_local_id}},\n  \"seleccion_visitante_id\": {{seleccion_local_id}},\n  \"fecha\": \"2026-06-20T20:00:00Z\",\n  \"estadio\": \"Estadio Central\",\n  \"fase\": \"GRUPOS\"\n}"
        }
      }
    },
    {
      "name": "Partidos - crear",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('partido_id', pm.response.json().data.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_admin}}" }
        ],
        "url": "{{base_url}}/api/partidos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"seleccion_local_id\": {{seleccion_local_id}},\n  \"seleccion_visitante_id\": {{seleccion_visitante_id}},\n  \"fecha\": \"2026-06-20T20:00:00Z\",\n  \"estadio\": \"Estadio Central\",\n  \"fase\": \"GRUPOS\"\n}"
        }
      }
    },
    {
      "name": "Partidos - listar",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": "{{base_url}}/api/partidos"
      }
    },
    {
      "name": "Partidos - detalle",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": "{{base_url}}/api/partidos/{{partido_id}}"
      }
    },
    {
      "name": "Partidos - por fase",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": "{{base_url}}/api/partidos/fase/GRUPOS"
      }
    },
    {
      "name": "Partidos - rechaza goles negativos",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.test('400 Bad Request', () => pm.response.to.have.status(400));"],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_admin}}" }
        ],
        "url": "{{base_url}}/api/partidos/{{partido_id}}/resultado",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"goles_local\": -1,\n  \"goles_visitante\": 0\n}"
        }
      }
    },
    {
      "name": "Partidos - registrar resultado",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('estado FINALIZADO', () => pm.expect(pm.response.json().data.estado).to.eql('FINALIZADO'));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_admin}}" }
        ],
        "url": "{{base_url}}/api/partidos/{{partido_id}}/resultado",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"goles_local\": 2,\n  \"goles_visitante\": 1\n}"
        }
      }
    },
    {
      "name": "Tabla - grupo A",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('calcula puntos', () => pm.expect(pm.response.json().data[0].PTS).to.eql(3));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": "{{base_url}}/api/grupos/A/tabla"
      }
    },
    {
      "name": "Import - Mundial 2022 base",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const data = pm.response.json().data;",
              "pm.test('importa 32 selecciones oficiales', () => pm.expect(data.selecciones_creadas + data.selecciones_existentes).to.eql(32));",
              "pm.collectionVariables.set('argentina_id', data.selecciones.Argentina);",
              "pm.collectionVariables.set('francia_id', data.selecciones.Francia);",
              "pm.collectionVariables.set('marruecos_id', data.selecciones.Marruecos);",
              "pm.collectionVariables.set('pendiente_id', data.selecciones.Pendiente);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": "{{base_url}}/api/import/mundial-2022"
      }
    },
    {
      "name": "Mundial 2022 - crear semifinal en progreso",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const data = pm.response.json().data;",
              "pm.collectionVariables.set('semifinal_reservada_id', data.id);",
              "pm.test('fase SEMIFINAL', () => pm.expect(data.fase).to.eql('SEMIFINAL'));",
              "pm.test('estado EN_JUEGO', () => pm.expect(data.estado).to.eql('EN_JUEGO'));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_admin}}" }
        ],
        "url": "{{base_url}}/api/partidos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"seleccion_local_id\": {{marruecos_id}},\n  \"seleccion_visitante_id\": {{francia_id}},\n  \"fecha\": \"2022-12-14T19:00:00Z\",\n  \"estadio\": \"Al Bayt\",\n  \"fase\": \"SEMIFINAL\",\n  \"estado\": \"EN_JUEGO\"\n}"
        }
      }
    },
    {
      "name": "Mundial 2022 - finalizar semifinal reservada",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const data = pm.response.json().data;",
              "pm.test('estado FINALIZADO', () => pm.expect(data.estado).to.eql('FINALIZADO'));",
              "pm.test('resultado Francia 2-0 Marruecos', () => { pm.expect(data.goles_local).to.eql(0); pm.expect(data.goles_visitante).to.eql(2); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_admin}}" }
        ],
        "url": "{{base_url}}/api/partidos/{{semifinal_reservada_id}}/resultado",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"goles_local\": 0,\n  \"goles_visitante\": 2\n}"
        }
      }
    },
    {
      "name": "Mundial 2022 - crear final programada con pendiente",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const data = pm.response.json().data;",
              "pm.collectionVariables.set('final_reservada_id', data.id);",
              "pm.test('fase FINAL', () => pm.expect(data.fase).to.eql('FINAL'));",
              "pm.test('estado PROGRAMADO', () => pm.expect(data.estado).to.eql('PROGRAMADO'));",
              "pm.test('rival pendiente', () => pm.expect(data.seleccion_visitante_id).to.eql(Number(pm.collectionVariables.get('pendiente_id'))));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_admin}}" }
        ],
        "url": "{{base_url}}/api/partidos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"seleccion_local_id\": {{argentina_id}},\n  \"seleccion_visitante_id\": {{pendiente_id}},\n  \"fecha\": \"2022-12-18T15:00:00Z\",\n  \"estadio\": \"Lusail\",\n  \"fase\": \"FINAL\",\n  \"estado\": \"PROGRAMADO\"\n}"
        }
      }
    },
    {
      "name": "Mundial 2022 - actualizar rival pendiente de la final",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const data = pm.response.json().data;",
              "pm.test('rival actualizado a Francia', () => pm.expect(data.seleccion_visitante_id).to.eql(Number(pm.collectionVariables.get('francia_id'))));",
              "pm.test('final sigue PROGRAMADO', () => pm.expect(data.estado).to.eql('PROGRAMADO'));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_admin}}" }
        ],
        "url": "{{base_url}}/api/partidos/{{final_reservada_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"seleccion_visitante_id\": {{francia_id}}\n}"
        }
      }
    },
    {
      "name": "Mundial 2022 - finalizar final reservada",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const data = pm.response.json().data;",
              "pm.test('estado FINALIZADO', () => pm.expect(data.estado).to.eql('FINALIZADO'));",
              "pm.test('resultado Argentina 3-3 Francia', () => { pm.expect(data.goles_local).to.eql(3); pm.expect(data.goles_visitante).to.eql(3); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_admin}}" }
        ],
        "url": "{{base_url}}/api/partidos/{{final_reservada_id}}/resultado",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"goles_local\": 3,\n  \"goles_visitante\": 3\n}"
        }
      }
    },
